{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Python: Run Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "jinja": true,
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "serverReadyAction": {
                "pattern": "Running on (https?://[0-9.:]+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        }
    ]
}